# Smart City MVP — без секретов. Скопируйте в .env и при необходимости измените.

POSTGRES_USER=smartcity
POSTGRES_PASSWORD=smartcity
POSTGRES_DB=smartcity

DATABASE_URL=postgresql+psycopg2://smartcity:smartcity@db:5432/smartcity

MAX_MODE=mock
MAX_BOT_TOKEN=

JWT_SECRET=dev-secret-change-me

# Frontend (пустой = relative /api через nginx в compose)
VITE_API_URL=
